PORT=4000
# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server only. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Comma-separated allowed frontend origins (your Vercel URL / custom domain)
CORS_ORIGINS=http://localhost:5173

# Google reviews / photos / map (optional; see README). Enable "Places API (New)" and create a key.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=ChIJA190-cETrjsR418j6j05C9s

# Admin page at /admin. Choose a long password (8+ characters). ADMIN_SECRET is optional extra signing key.
ADMIN_PASSWORD=
ADMIN_SECRET=
